# ============================================================
# 部署环境变量示例（复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不入库）
#
# 两类变量：
#   A. 前端（VITE_ 开头）：构建时注入，会出现在打包产物里 —— 只放「你自己后端地址」。
#   B. 后端（ZHIPU_* / PORT）：只在 Node 后端进程内使用，密钥绝不下发浏览器。
#
# 云端部署（Docker / PaaS）建议：直接通过平台的环境变量面板注入 B 类变量，
# 不创建 .env 文件；本地开发可保留 .env 由 server/index.js 自动读取。
# ============================================================

# ---------- A. 前端 ----------
# 后端接口地址。留空或保持 /api/chat 即可（前端与后端同源，由同一 Node 进程托管）。
# 若把后端单独部署到别的域名，改为：https://your-server.example.com/api/chat
# ⚠️ 切勿填写裸 LLM 厂商端点（如 https://open.bigmodel.cn/.../chat/completions），
#    前端会自动忽略此类值并回退到 /api/chat，以免泄露密钥域名。
VITE_CHAT_API_URL=/api/chat

# ---------- B. 后端（AI 答疑小助手代理） ----------
# 智谱 BigModel API Key（仅在后端使用）
ZHIPU_API_KEY=your-zhipu-api-key-here
# 模型名（默认 glm-4-flash）
ZHIPU_MODEL=glm-4-flash
# 智谱 API Base（默认官方地址，一般无需改）
ZHIPU_BASE=https://open.bigmodel.cn/api/paas/v4
# 服务端口（云端平台通常会注入 PORT，此处为本地/默认值）
PORT=8787

# ---------- C. 访客分析 / 微信即时提醒 ----------
# Server酱 SendKey（https://sc.ftqq.com 扫码关注后获取）。
# 配置了才把「新访客到访 / AI答疑被提问」实时推送到你的微信；留空则只做后台统计、不推送。
SERVERCHAN_KEY=

# 统计后台页访问密码。访问 /stats?token=这里的值 查看访客数据。强烈建议设置，否则任何人可看访客 IP。
ADMIN_TOKEN=

# 可选：事件数据存储目录（默认 server/data）。容器/云部署建议指向持久卷，如 /var/data/portfolio
# ANALYTICS_DIR=/var/data/portfolio
